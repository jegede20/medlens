# All optional. MedLens runs without any keys (Tesseract OCR + label wording, in-memory cache).

# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional model override. Must support images + strict JSON schema (Groq's vision model).
GROQ_MODEL=qwen/qwen3.8-27b

# Free openFDA key raises the daily limit: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# Supabase free tier, used ONLY to cache label results by drug name (no personal data).
# Run supabase/schema.sql once in the Supabase SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
